#!/usr/bin/env bash
# tasmota-build-mem-diff -- Vergleicht Speicherbelegungen zweier Tasmota-Builds
# aus der CSV-Datenbank, die tasmota-build-capture erzeugt.
#
# Aufruf: tasmota-build-mem-diff [OPTIONEN] [feature-branch [ref-branch]]
#
# Argumente:
#   feature-branch      Branch des Feature-Builds
#                       (Default: juengster Non-development-Branch)
#   ref-branch          Branch des Referenz-Builds (Default: development)
#
# Optionen (Auswahl):
#   --feat-commit <hash>      Feature-Build nach Commit-Hash auswaehlen (Praefixmatch)
#   --ref-commit  <hash>      Referenz-Build nach Commit-Hash auswaehlen (Praefixmatch)
#   --feat-capture <ts>       Feature-Build nach Capture-Zeitstempel auswaehlen (Praefixmatch)
#   --ref-capture  <ts>       Referenz-Build nach Capture-Zeitstempel auswaehlen (Praefixmatch)
#
# Optionen (Ausgabe):
#   --plain          Einfache Textausgabe (Default)
#   --markdown       Markdown-Tabelle
#   --rst            reStructuredText-Grid-Tabelle
#   --list [branch]  Alle erfassten Builds auflisten, optional nach Branch gefiltert
#   -h, --help       Hilfe
#
# Mehrere Selektionskriterien fuer dieselbe Seite (ref oder feat) muessen
# auf denselben Datensatz konvergieren, sonst Fehler.
# Bei Mehrdeutigkeit durch Commit-Hash wird der juengste Capture gewaehlt
# und eine Warnung ausgegeben.
#
# Voraussetzungen: gawk

# ---------------------------------------------------------------------------
# Konfiguration
# ---------------------------------------------------------------------------
readonly CSV_FILENAME="tasmota-builds.csv"
readonly REF_BRANCH_DEFAULT="development"
# Maximaler Zeitabstand zwischen Feature- und Referenz-Build in Sekunden.
# Bei Ueberschreitung wird gewarnt. 3600 = 1 Stunde.
readonly MAX_BUILD_AGE_DIFF_S=3600

# ---------------------------------------------------------------------------
# Initialisierung
# ---------------------------------------------------------------------------
PROGDIR="$(dirname "$(readlink -f "$0")")"
readonly PROGDIR

CSV_FILE="${PROGDIR}/${CSV_FILENAME}"

# ---------------------------------------------------------------------------
# Hilfsfunktionen
# ---------------------------------------------------------------------------
die() {
    echo "FEHLER: $*" >&2
    exit 1
}

usage() {
    sed -n '/^# Aufruf:/,/^# Voraussetzungen/p' "$0" | grep '^#' | sed 's/^# \{0,1\}//'
    exit 0
}

# ---------------------------------------------------------------------------
# Argumente parsen
# ---------------------------------------------------------------------------
OUTPUT_FORMAT="plain"
LIST_MODE=0
LIST_BRANCH=""
FEATURE_BRANCH=""
REF_BRANCH=""
FEAT_COMMIT=""
REF_COMMIT=""
FEAT_CAPTURE=""
REF_CAPTURE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --plain)         OUTPUT_FORMAT="plain";    shift ;;
        --markdown)      OUTPUT_FORMAT="markdown"; shift ;;
        --rst)           OUTPUT_FORMAT="rst";      shift ;;
        --list)
            LIST_MODE=1
            shift
            # Optionales Branch-Argument
            if [[ $# -gt 0 && "$1" != --* ]]; then
                LIST_BRANCH="$1"; shift
            fi
            ;;
        --feat-commit)   [[ $# -gt 1 ]] || die "--feat-commit benoetigt ein Argument"
                         FEAT_COMMIT="$2";   shift 2 ;;
        --ref-commit)    [[ $# -gt 1 ]] || die "--ref-commit benoetigt ein Argument"
                         REF_COMMIT="$2";    shift 2 ;;
        --feat-capture)  [[ $# -gt 1 ]] || die "--feat-capture benoetigt ein Argument"
                         FEAT_CAPTURE="$2";  shift 2 ;;
        --ref-capture)   [[ $# -gt 1 ]] || die "--ref-capture benoetigt ein Argument"
                         REF_CAPTURE="$2";   shift 2 ;;
        -h|--help)       usage ;;
        -*)              die "Unbekannte Option: $1" ;;
        *)
            if   [[ -z "${FEATURE_BRANCH}" ]]; then FEATURE_BRANCH="$1"
            elif [[ -z "${REF_BRANCH}"     ]]; then REF_BRANCH="$1"
            else die "Zu viele Argumente: $1"
            fi
            shift
            ;;
    esac
done

# ---------------------------------------------------------------------------
# Voraussetzungen pruefen
# ---------------------------------------------------------------------------
[[ -f "${CSV_FILE}" ]] || die "CSV-Datei nicht gefunden: ${CSV_FILE}"
command -v gawk >/dev/null || die "gawk nicht gefunden"

# ---------------------------------------------------------------------------
# --list Modus
# ---------------------------------------------------------------------------
if [[ ${LIST_MODE} -eq 1 ]]; then
    gawk -v filterBranch="${LIST_BRANCH}" '
    BEGIN {
        FS = ","
        COL_CAPTURE_TS =  1
        COL_BRANCH     =  2
        COL_COMMIT     =  3
        COL_COMMIT_TS  =  4
        COL_TARGET     =  5
        COL_PLAT_VER   =  7
        COL_FW_URL     =  9
        COL_STATUS     = 10
        COL_DURATION   = 11
    }
    NR == 1 { next }
    $COL_STATUS != "SUCCESS" { next }
    filterBranch != "" && $COL_BRANCH != filterBranch { next }
    {
        branch    = $COL_BRANCH
        captureTs = $COL_CAPTURE_TS
        commitH   = substr($COL_COMMIT, 1, 8)
        commitTs  = substr($COL_COMMIT_TS, 1, 16)
        gsub(/T/, " ", commitTs)
        target    = $COL_TARGET
        platVer   = $COL_PLAT_VER
        fwUrl     = $COL_FW_URL
        dur       = $COL_DURATION

        # fwVersion: "framework-arduinoespressif32 @ 3.3.8+sha.f2a3fa2b" -> "3.3.8+sha.f2a3fa2b"
        fwVer = fwUrl
        if (match(fwUrl, /@ ([^[:space:]]+)/, a)) fwVer = a[1]

        capShort = substr(captureTs, 1, 16)
        gsub(/T/, " ", capShort)

        printf "%-30s  %-8s  %-16s  %-16s  %-12s  %-28s  %ss\n",
            branch, commitH, commitTs, capShort, platVer, fwVer, dur
    }
    ' "${CSV_FILE}" | sort -k3,3 -k1,1 -k4,4
    exit 0
fi

# ---------------------------------------------------------------------------
# CSV einlesen, Selektion und Diff (gawk)
# ---------------------------------------------------------------------------
# Spaltenindex-Mapping (1-basiert):
#  1  capture_timestamp    9  framework_url      17  iram_total
#  2  branch              10  status             18  flash_code
#  3  commit_hash         11  build_duration_s   19  flash_data
#  4  commit_timestamp    12  ram_used           20  dram_used
#  5  target              13  ram_total          21  dram_total
#  6  platform_name       14  flash_used         22  rtc_slow_used
#  7  platform_version    15  flash_total        23  rtc_slow_total
#  8  platform_url        16  iram_used

QUERY_RESULT="$(gawk \
    -v featureBranch="${FEATURE_BRANCH}" \
    -v refBranch="${REF_BRANCH}" \
    -v refDefault="${REF_BRANCH_DEFAULT}" \
    -v featCommitFilter="${FEAT_COMMIT}" \
    -v refCommitFilter="${REF_COMMIT}" \
    -v featCaptureFilter="${FEAT_CAPTURE}" \
    -v refCaptureFilter="${REF_CAPTURE}" \
    -v MAX_BUILD_AGE_DIFF="${MAX_BUILD_AGE_DIFF_S}" \
    'BEGIN {
        FS = ","
        COL_CAPTURE_TS =  1;  COL_BRANCH    =  2;  COL_COMMIT    =  3
        COL_COMMIT_TS  =  4;  COL_TARGET    =  5;  COL_PLAT_NAME =  6
        COL_PLAT_VER   =  7;  COL_PLAT_URL  =  8;  COL_FW_URL    =  9
        COL_STATUS     = 10;  COL_DURATION  = 11;  COL_RAM_USED  = 12
        COL_RAM_TOTAL  = 13;  COL_FLASH_USED= 14;  COL_FLASH_TOTAL=15
        COL_IRAM_USED  = 16;  COL_IRAM_TOTAL= 17
    }

    NR == 1 { next }
    $COL_STATUS != "SUCCESS" { next }

    function hasPrefix(str, prefix) {
        return prefix != "" && substr(str, 1, length(prefix)) == prefix
    }

    function fwVersion(s,    a) {
        if (match(s, /@ ([^[:space:]]+)/, a)) return a[1]
        return s
    }

    function isoToEpoch(ts,    p) {
        gsub(/[-:TZ+]/, " ", ts)
        split(ts, p, " ")
        return ((p[1]-1970)*365.25*86400) + (p[2]*30.44*86400) + \
               (p[3]*86400) + (p[4]*3600) + (p[5]*60) + p[6]
    }

    # Phase 1: alle Zeilen einlesen, Branch-Uebersicht aufbauen
    {
        branch     = $COL_BRANCH
        captureTs  = $COL_CAPTURE_TS
        commitHash = $COL_COMMIT

        # Branch-Uebersicht fuer Default-Bestimmung
        if (captureTs > allBranch[branch] || allBranch[branch] == "")
            allBranch[branch] = captureTs
        if (branch != refDefault && (captureTs > nonRefBranch[branch] || nonRefBranch[branch] == ""))
            nonRefBranch[branch] = captureTs

        # Alle Rohdaten speichern fuer Phase 2
        rows[NR]["captureTs"]  = captureTs
        rows[NR]["branch"]     = branch
        rows[NR]["commitHash"] = commitHash
        rows[NR]["commitTs"]   = $COL_COMMIT_TS
        rows[NR]["target"]     = $COL_TARGET
        rows[NR]["platName"]   = $COL_PLAT_NAME
        rows[NR]["platVer"]    = $COL_PLAT_VER
        rows[NR]["platUrl"]    = $COL_PLAT_URL
        rows[NR]["fwUrl"]      = $COL_FW_URL
        rows[NR]["ramUsed"]    = $COL_RAM_USED
        rows[NR]["ramTotal"]   = $COL_RAM_TOTAL
        rows[NR]["flashUsed"]  = $COL_FLASH_USED
        rows[NR]["flashTotal"] = $COL_FLASH_TOTAL
        rows[NR]["iramUsed"]   = $COL_IRAM_USED
        rows[NR]["iramTotal"]  = $COL_IRAM_TOTAL
    }

    END {
        # --- Branches bestimmen ---
        if (refBranch == "") refBranch = refDefault

        if (featureBranch == "" && featCommitFilter == "" && featCaptureFilter == "") {
            bestTs = ""
            for (b in nonRefBranch) {
                if (b == refBranch) continue
                if (nonRefBranch[b] > bestTs) { bestTs = nonRefBranch[b]; featureBranch = b }
            }
            if (featureBranch == "") {
                print "ERROR:Kein Non-" refBranch "-Branch in der CSV gefunden"
                exit 1
            }
        }

        # --- Phase 2: Zeilen filtern und den richtigen Seiten zuordnen ---
        for (nr in rows) {
            branch     = rows[nr]["branch"]
            captureTs  = rows[nr]["captureTs"]
            commitHash = rows[nr]["commitHash"]
            target     = rows[nr]["target"]

            for (side = 1; side <= 2; side++) {
                if (side == 1) {
                    bExpected = refBranch;     cFilter = refCommitFilter
                    tsFilter  = refCaptureFilter; sideTag = "ref"
                } else {
                    bExpected = featureBranch; cFilter = featCommitFilter
                    tsFilter  = featCaptureFilter; sideTag = "feat"
                }

                # Branch muss passen (wenn featureBranch noch unbekannt: kein Branch-Filter fuer feat)
                if (bExpected != "" && branch != bExpected) continue

                # Commit-Filter
                if (cFilter != "" && !hasPrefix(commitHash, cFilter)) continue

                # Capture-Filter
                if (tsFilter != "" && !hasPrefix(captureTs, tsFilter)) continue

                key = sideTag SUBSEP branch SUBSEP target
                if (captureTs > sideCapture[key] || sideCapture[key] == "") {
                    sideCapture[key]    = captureTs
                    sideCommit[key]     = commitHash
                    sideCommitTs[key]   = rows[nr]["commitTs"]
                    sideBranch[key]     = branch
                    sidePlatName[key]   = rows[nr]["platName"]
                    sidePlatVer[key]    = rows[nr]["platVer"]
                    sidePlatUrl[key]    = rows[nr]["platUrl"]
                    sideFwUrl[key]      = rows[nr]["fwUrl"]
                    sideRamUsed[key]    = rows[nr]["ramUsed"]
                    sideRamTotal[key]   = rows[nr]["ramTotal"]
                    sideFlashUsed[key]  = rows[nr]["flashUsed"]
                    sideFlashTotal[key] = rows[nr]["flashTotal"]
                    sideIramUsed[key]   = rows[nr]["iramUsed"]
                    sideIramTotal[key]  = rows[nr]["iramTotal"]
                }

                # Commit-Mehrdeutigkeit: verschiedene Commits fuer denselben Filter
                commitKey = sideTag SUBSEP branch SUBSEP target SUBSEP commitHash
                seenCommits[commitKey] = 1
            }

            # Feature-Branch aus gematchten Daten ableiten wenn noch unbekannt
            if (featureBranch == "") {
                for (key in sideCapture) {
                    split(key, kp, SUBSEP)
                    if (kp[1] == "feat") { featureBranch = kp[2]; break }
                }
            }
        }

        # --- Commit-Mehrdeutigkeit pruefen ---
        for (ck in seenCommits) {
            split(ck, cp, SUBSEP)
            baseKey = cp[1] SUBSEP cp[2] SUBSEP cp[3]
            distinctCommits[baseKey]++
        }
        for (baseKey in distinctCommits) {
            if (distinctCommits[baseKey] > 1) {
                split(baseKey, bp, SUBSEP)
                printf "WARN:Commit-Hash mehrdeutig fuer %s %s Target %s (%d Commits) -- juengster wird gewaehlt\n", \
                    bp[1], bp[2], bp[3], distinctCommits[baseKey]
            }
        }

        # --- Konvergenz-Pruefung: alle Targets einer Seite sollen aus demselben Build-Lauf stammen ---
        # D.h. gleicher Commit-Hash und gleicher Capture-Zeitstempel pro Seite+Branch.
        # Nur relevant wenn der Nutzer Selektions-Filter angegeben hat.
        for (side = 1; side <= 2; side++) {
            sideTag  = (side == 1) ? "ref"  : "feat"
            bExpected= (side == 1) ? refBranch : featureBranch
            cFilter  = (side == 1) ? refCommitFilter  : featCommitFilter
            tsFilter = (side == 1) ? refCaptureFilter : featCaptureFilter
            if (cFilter == "" && tsFilter == "") continue   # kein expliziter Filter -> keine Pruefung

            refCommitSeen = ""; refCaptureSeen = ""
            for (key in sideCapture) {
                split(key, kp, SUBSEP)
                if (kp[1] != sideTag || kp[2] != bExpected) continue
                ch = sideCommit[key]; ts = sideCapture[key]
                if (refCommitSeen == "") { refCommitSeen = ch; refCaptureSeen = ts; continue }
                if (ch != refCommitSeen || ts != refCaptureSeen) {
                    printf "WARN:%s-Selektionskriterien fuehren zu unterschiedlichen Builds pro Target\n", \
                        (side==1 ? "Ref" : "Feat")
                    break
                }
            }
        }

        # --- Pruefen ob Daten vorhanden ---
        refFound = 0; featFound = 0
        for (key in sideCapture) {
            split(key, kp, SUBSEP)
            if (kp[1] == "ref"  && kp[2] == refBranch)     refFound  = 1
            if (kp[1] == "feat" && kp[2] == featureBranch) featFound = 1
        }
        if (!refFound) {
            printf "ERROR:Keine Daten fuer Referenz-Branch: %s%s%s\n", refBranch,
                (refCommitFilter  != "" ? " commit="  refCommitFilter  : ""),
                (refCaptureFilter != "" ? " capture=" refCaptureFilter : "")
            exit 1
        }
        if (!featFound) {
            printf "ERROR:Keine Daten fuer Feature-Branch: %s%s%s\n", featureBranch,
                (featCommitFilter  != "" ? " commit="  featCommitFilter  : ""),
                (featCaptureFilter != "" ? " capture=" featCaptureFilter : "")
            exit 1
        }

        # --- Zeitabstand der Captures pruefen ---
        refCaptureRep = ""; featCaptureRep = ""
        for (key in sideCapture) {
            split(key, kp, SUBSEP)
            if (kp[1] == "ref"  && kp[2] == refBranch     && refCaptureRep  == "") refCaptureRep  = sideCapture[key]
            if (kp[1] == "feat" && kp[2] == featureBranch && featCaptureRep == "") featCaptureRep = sideCapture[key]
        }
        diffS = isoToEpoch(refCaptureRep) - isoToEpoch(featCaptureRep)
        if (diffS < 0) diffS = -diffS
        if (diffS > MAX_BUILD_AGE_DIFF + 0) {
            h = int(diffS / 3600); m = int((diffS % 3600) / 60)
            printf "WARN:Zeitabstand zwischen Builds: %dh %02dm\n", h, m
        }

        # --- Metadaten-Abweichungen pruefen ---
        for (key in sideCapture) {
            split(key, kp, SUBSEP)
            if (kp[1] != "ref") continue
            tgt = kp[3]
            rk = "ref"  SUBSEP refBranch     SUBSEP tgt
            fk = "feat" SUBSEP featureBranch SUBSEP tgt
            if (!(fk in sidePlatVer)) continue
            if (sidePlatVer[rk] != sidePlatVer[fk])
                printf "WARN:Platform-Version unterschiedlich fuer %s: ref=%s feature=%s\n", \
                    tgt, sidePlatVer[rk], sidePlatVer[fk]
            refFwVer  = fwVersion(sideFwUrl[rk])
            featFwVer = fwVersion(sideFwUrl[fk])
            if (sideFwUrl[rk] != "" && sideFwUrl[fk] != "" && refFwVer != featFwVer)
                printf "WARN:Framework-Version unterschiedlich fuer %s: ref=%s feature=%s\n", \
                    tgt, refFwVer, featFwVer
        }

        # --- Repraesantative Metadaten fuer den Ausgabe-Header ---
        refCommitOut = ""; refCommitTsOut = ""; refCaptureOut = ""
        featCommitOut= ""; featCommitTsOut= ""; featCaptureOut= ""
        for (key in sideCapture) {
            split(key, kp, SUBSEP)
            if (kp[1] == "ref"  && kp[2] == refBranch     && refCommitOut  == "") {
                refCommitOut   = sideCommit[key]
                refCommitTsOut = sideCommitTs[key]
                refCaptureOut  = sideCapture[key]
            }
            if (kp[1] == "feat" && kp[2] == featureBranch && featCommitOut == "") {
                featCommitOut   = sideCommit[key]
                featCommitTsOut = sideCommitTs[key]
                featCaptureOut  = sideCapture[key]
            }
        }

        print "REF_BRANCH:"      refBranch
        print "REF_COMMIT:"      refCommitOut
        print "REF_COMMIT_TS:"   refCommitTsOut
        print "REF_CAPTURE_TS:"  refCaptureOut
        print "FEAT_BRANCH:"     featureBranch
        print "FEAT_COMMIT:"     featCommitOut
        print "FEAT_COMMIT_TS:"  featCommitTsOut
        print "FEAT_CAPTURE_TS:" featCaptureOut
        print "---"

        # --- Datenzeilen: ref-Targets ---
        for (key in sideCapture) {
            split(key, kp, SUBSEP)
            if (kp[1] != "ref" || kp[2] != refBranch) continue
            tgt = kp[3]
            rk = "ref"  SUBSEP refBranch     SUBSEP tgt
            fk = "feat" SUBSEP featureBranch SUBSEP tgt

            ramRef    = (rk in sideRamUsed)   ? sideRamUsed[rk]   : "n/a"
            ramFeat   = (fk in sideRamUsed)   ? sideRamUsed[fk]   : "n/a"
            flashRef  = (rk in sideFlashUsed) ? sideFlashUsed[rk] : "n/a"
            flashFeat = (fk in sideFlashUsed) ? sideFlashUsed[fk] : "n/a"
            iramRef   = (rk in sideIramUsed)  ? sideIramUsed[rk]  : "n/a"
            iramFeat  = (fk in sideIramUsed)  ? sideIramUsed[fk]  : "n/a"

            ramDiff   = (ramRef   != "n/a" && ramFeat   != "n/a") ? ramFeat   - ramRef   : "n/a"
            flashDiff = (flashRef != "n/a" && flashFeat != "n/a") ? flashFeat - flashRef : "n/a"
            iramDiff  = (iramRef  != "n/a" && iramFeat  != "n/a") ? iramFeat  - iramRef  : "n/a"

            if (ramDiff   != "n/a" && ramDiff   > 0) ramDiff   = "+" ramDiff
            if (flashDiff != "n/a" && flashDiff > 0) flashDiff = "+" flashDiff
            if (iramDiff  != "n/a" && iramDiff  > 0) iramDiff  = "+" iramDiff

            printf "DATA:%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n",
                tgt, ramRef, ramFeat, ramDiff, flashRef, flashFeat, flashDiff, iramRef, iramFeat, iramDiff
        }

        # --- Datenzeilen: nur in feat vorhandene Targets ---
        for (key in sideCapture) {
            split(key, kp, SUBSEP)
            if (kp[1] != "feat" || kp[2] != featureBranch) continue
            tgt = kp[3]
            if (("ref" SUBSEP refBranch SUBSEP tgt) in sideRamUsed) continue
            printf "DATA:%s\tn/a\t%s\tn/a\tn/a\t%s\tn/a\tn/a\t%s\tn/a\n",
                tgt, sideRamUsed[key], sideFlashUsed[key], sideIramUsed[key]
        }
    }
' "${CSV_FILE}")"


# ---------------------------------------------------------------------------
# Fehler abfangen
# ---------------------------------------------------------------------------
if echo "${QUERY_RESULT}" | grep -q '^ERROR:'; then
    echo "${QUERY_RESULT}" | grep '^ERROR:' | sed 's/^ERROR:/FEHLER:/' >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Warnungen ausgeben
# ---------------------------------------------------------------------------
echo "${QUERY_RESULT}" | grep '^WARN:' | sed 's/^WARN:/WARNUNG: /' >&2

# ---------------------------------------------------------------------------
# Metadaten extrahieren
# ---------------------------------------------------------------------------
refBranch="$(   echo "${QUERY_RESULT}" | grep '^REF_BRANCH:'      | cut -d: -f2-)"
refCommit="$(   echo "${QUERY_RESULT}" | grep '^REF_COMMIT:'      | cut -d: -f2- | cut -c1-8)"
refCommitTs="$( echo "${QUERY_RESULT}" | grep '^REF_COMMIT_TS:'   | cut -d: -f2-)"
featBranch="$(  echo "${QUERY_RESULT}" | grep '^FEAT_BRANCH:'     | cut -d: -f2-)"
featCommit="$(  echo "${QUERY_RESULT}" | grep '^FEAT_COMMIT:'     | cut -d: -f2- | cut -c1-8)"
featCommitTs="$(echo "${QUERY_RESULT}" | grep '^FEAT_COMMIT_TS:'  | cut -d: -f2-)"

refTs="$(  echo "${refCommitTs}"  | sed 's/T/ /; s/\(.\{16\}\).*/\1/')"
featTs="$( echo "${featCommitTs}" | sed 's/T/ /; s/\(.\{16\}\).*/\1/')"

# ---------------------------------------------------------------------------
# Datenzeilen extrahieren und sortiert ausgeben
# ---------------------------------------------------------------------------
mapfile -t DATA_LINES < <(echo "${QUERY_RESULT}" | grep '^DATA:' | sed 's/^DATA://' | sort)

# Felder pro Datenzeile (tab-getrennt):
# target  ram_ref ram_feat ram_diff  flash_ref flash_feat flash_diff  iram_ref iram_feat iram_diff

# ---------------------------------------------------------------------------
# Ausgabe erzeugen
# ---------------------------------------------------------------------------

outputPlain() {
    echo "Ref:     ${refBranch} @ ${refCommit} (${refTs})"
    echo "Feature: ${featBranch} @ ${featCommit} (${featTs})"
    echo ""
    for line in "${DATA_LINES[@]}"; do
        IFS=$'\t' read -r target ramRef ramFeat ramDiff flashRef flashFeat flashDiff iramRef iramFeat iramDiff <<< "${line}"
        printf "%-20s  RAM: %7s  IRAM: %7s  Flash: %7s\n" \
            "${target}" "${ramDiff}" "${iramDiff}" "${flashDiff}"
    done
}

outputMarkdown() {
    echo "## Memory comparison: \`${refBranch}\` → \`${featBranch}\`"
    echo ""
    printf "| %-20s | %12s | %12s | %12s |\n" "Target" "RAM [bytes]" "IRAM [bytes]" "Flash [bytes]"
    printf "|%s|%s|%s|%s|\n" \
        "$(printf '%0.s-' {1..22})" \
        "$(printf '%0.s-' {1..14})" \
        "$(printf '%0.s-' {1..14})" \
        "$(printf '%0.s-' {1..14})"
    for line in "${DATA_LINES[@]}"; do
        IFS=$'\t' read -r target ramRef ramFeat ramDiff flashRef flashFeat flashDiff iramRef iramFeat iramDiff <<< "${line}"
        printf "| %-20s | %12s | %12s | %12s |\n" \
            "${target}" "${ramDiff}" "${iramDiff}" "${flashDiff}"
    done
    echo ""
    echo "Ref:     \`${refBranch}\` @ \`${refCommit}\` (${refTs})"
    echo "Feature: \`${featBranch}\` @ \`${featCommit}\` (${featTs})"
}

outputRst() {
    local colTarget=22 colRam=13 colIram=14 colFlash=15
    for line in "${DATA_LINES[@]}"; do
        IFS=$'\t' read -r target _ _ _ _ _ _ _ _ _ <<< "${line}"
        local tlen=$(( ${#target} + 2 ))
        (( tlen > colTarget )) && colTarget=${tlen}
    done

    rstHRule() {
        local c="$1"
        printf "+%s+%s+%s+%s+\n" \
            "$(printf "%${colTarget}s" | tr ' ' "${c}")" \
            "$(printf "%${colRam}s"    | tr ' ' "${c}")" \
            "$(printf "%${colIram}s"   | tr ' ' "${c}")" \
            "$(printf "%${colFlash}s"  | tr ' ' "${c}")"
    }
    rstRow() {
        printf "| %-$((colTarget-2))s | %$((colRam-2))s | %$((colIram-2))s | %$((colFlash-2))s |\n" \
            "$1" "$2" "$3" "$4"
    }

    echo "Memory comparison: \`\`${refBranch}\`\` → \`\`${featBranch}\`\`"
    echo ""
    rstHRule "-"
    rstRow "Target" "RAM [bytes]" "IRAM [bytes]" "Flash [bytes]"
    rstHRule "="
    for line in "${DATA_LINES[@]}"; do
        IFS=$'\t' read -r target ramRef ramFeat ramDiff flashRef flashFeat flashDiff iramRef iramFeat iramDiff <<< "${line}"
        rstRow "${target}" "${ramDiff}" "${iramDiff}" "${flashDiff}"
        rstHRule "-"
    done
    echo ""
    echo "| Ref:     \`\`${refBranch}\`\` @ \`\`${refCommit}\`\` (${refTs})"
    echo "| Feature: \`\`${featBranch}\`\` @ \`\`${featCommit}\`\` (${featTs})"
}

case "${OUTPUT_FORMAT}" in
    plain)    outputPlain    ;;
    markdown) outputMarkdown ;;
    rst)      outputRst      ;;
esac
